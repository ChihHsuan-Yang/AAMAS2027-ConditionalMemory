# secrets — never commit
*.env
.env
*token*.json
.globus/

# data: large / licensed benchmark material is NOT redistributed here
data/**
!data/README.md
!data/manifests/
!data/manifests/**

# results: raw endpoint outputs are large; only ledgers + manifests are tracked
results/**
!results/README.md
!results/ledgers/
!results/ledgers/**
# SWE-bench pilot + control artifacts ARE tracked: they are small (<100KB each)
# and every number in docs/BENCHMARK_C_DECISION.md is re-derived from them by a
# reviewer. floor_pilot.json was already tracked for that reason; its successors
# and the scorer positive controls must be too, or the parity claim and the
# 20/20 control rest on files nobody else can open.
!results/swebench/
!results/swebench/*.json

# caches
cache/
*.npy
.cache/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.venv/
venv/

# os
.DS_Store

# benchmark raw records are large; summaries are tracked explicitly
results/bench/*_raw.jsonl
!results/bench/*.jsonl

# HF staging is built OUTSIDE this repo and is never committed or uploaded from here.
hf_staging/
hf_out/
*.rejected.jsonl
logs/
